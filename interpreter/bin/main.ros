importa "vector" ca v;
importa "matematica" ca m;

// ---------- Metrici ----------

functie eroare_mse(var y_true, var y_pred) {
    var nn = lungime(y_true);
    var suma = 0.0;
    pentru (var i = 0; i < nn; i++) {
        var diff = y_pred[i] - y_true[i];
        suma = suma + diff * diff;
    }
    returneaza suma / nn;
}

functie eroare_mae(var y_true, var y_pred) {
    var nn = lungime(y_true);
    var suma = 0.0;
    pentru (var i = 0; i < nn; i++) {
        suma = suma + m.abs(y_pred[i] - y_true[i]);
    }
    returneaza suma / nn;
}

functie eroare_r_squared(var y_true, var y_pred) {
    var nn = lungime(y_true);
    var medie = 0.0;
    pentru (var i = 0; i < nn; i++) {
        medie = medie + y_true[i];
    }
    medie = medie / nn;

    var suma_res = 0.0;
    var suma_tot = 0.0;
    pentru (var i = 0; i < nn; i++) {
        var diff_res = y_true[i] - y_pred[i];
        var diff_tot = y_true[i] - medie;
        suma_res = suma_res + diff_res * diff_res;
        suma_tot = suma_tot + diff_tot * diff_tot;
    }
    daca (suma_tot == 0) {
        returneaza 0.0;
    }
    returneaza 1 - (suma_res / suma_tot);
}

// ---------- Model ----------

functie prezice(var x, var w, var b) {
    var nr_ex = lungime(x);
    var nr_car = lungime(w);
    var rezultate = [];

    pentru (var i = 0; i < nr_ex; i++) {
        var y_pred = b;
        pentru (var j = 0; j < nr_car; j++) {
            y_pred = y_pred + w[j] * x[i,j];
        }
        v.adauga(rezultate, y_pred);
    }
    returneaza rezultate;
}

// Standardizeaza coloanele: returneaza [x_standardizat, medii, deviatii]
functie standardizeaza(var x) {
    var nr_ex = lungime(x);
    var nr_car = lungime(x[0]);
    var medii = [];
    var dev = [];

    pentru (var j = 0; j < nr_car; j++) {
        var s = 0.0;
        pentru (var i = 0; i < nr_ex; i++) {
            s = s + x[i,j];
        }
        var mu = s / nr_ex;

        var s2 = 0.0;
        pentru (var i = 0; i < nr_ex; i++) {
            var d = x[i,j] - mu;
            s2 = s2 + d * d;
        }
        var sd = m.radp(s2 / nr_ex);
        daca (sd == 0) {
            sd = 1.0;
        }
        v.adauga(medii, mu);
        v.adauga(dev, sd);
    }

    var z = [];
    pentru (var i = 0; i < nr_ex; i++) {
        var linie = [];
        pentru (var j = 0; j < nr_car; j++) {
            v.adauga(linie, (x[i,j] - medii[j]) / dev[j]);
        }
        v.adauga(z, linie);
    }
    returneaza [z, medii, dev];
}

// Gradient descent pe date standardizate. Nicio alocare in bucla de epoci.
functie regresie_liniara(var x, var y, var invatare, var epoci) {
    var nr_ex = lungime(x);
    var nr_car = lungime(x[0]);
    var pas = invatare / nr_ex;

    var w = [];
    var dw = [];
    pentru (var j = 0; j < nr_car; j++) {
        v.adauga(w, 0.0);
        v.adauga(dw, 0.0);
    }
    var b = 0.0;

    pentru (var ep = 0; ep < epoci; ep++) {
        pentru (var j = 0; j < nr_car; j++) {
            dw[j] = 0.0;
        }
        var db = 0.0;

        pentru (var i = 0; i < nr_ex; i++) {
            var eroare = b - y[i];
            pentru (var j = 0; j < nr_car; j++) {
                eroare = eroare + w[j] * x[i,j];
            }
            pentru (var j = 0; j < nr_car; j++) {
                dw[j] = dw[j] + eroare * x[i,j];
            }
            db = db + eroare;
        }

        pentru (var j = 0; j < nr_car; j++) {
            w[j] = w[j] - pas * dw[j];
        }
        b = b - pas * db;
    }
    returneaza [w, b];
}

// ---------- Date (generate cu seed fix, y = 3*x1 - 2*x2 + 0.5*x3 + x4 - x5 + 7) ----------

var x_train = [
    [4, -2, 6, -5, -4],
    [-3, 5, -5, 10, 0],
    [-5, -4, 7, 7, -4],
    [1, -4, 7, -5, -3],
    [1, -5, 6, -5, 1],
    [-5, -2, 3, 7, -2],
    [-3, 3, -1, -3, 0],
    [5, -3, -4, -5, 0],
    [9, 7, 4, 8, 8],
    [5, 3, 1, -1, 1],
    [-4, 3, 10, 9, 4],
    [8, 3, -4, -3, 10],
    [7, -1, 4, -2, 9],
    [7, -5, -4, 4, 4],
    [5, 9, 8, -4, -4],
    [2, 9, -4, -5, 3],
    [8, 3, 6, 5, -6],
    [8, 5, -1, -3, 9],
    [-5, 0, 3, -2, 1],
    [6, 6, 9, -4, -1],
    [8, 6, 2, -2, 7],
    [2, 7, 5, 6, 1],
    [-2, -4, -1, -2, 1],
    [1, -6, 9, -1, 2],
    [3, -6, -2, 7, 5],
    [4, -2, 10, -5, 8],
    [6, 6, 6, 6, -3],
    [9, 6, -5, 0, -4],
    [0, 8, -1, -3, 4],
    [-5, -3, -6, -2, -3],
    [5, -6, -4, 0, 6],
    [-2, 2, 5, 5, 9],
    [-3, -3, 9, 8, 9],
    [9, 3, -4, -2, -3],
    [4, 2, 9, -1, 10],
    [-6, 0, 10, 5, -2],
    [-6, 10, 3, -4, 2],
    [10, 5, -1, 5, 1],
    [10, 4, 1, 0, 1],
    [6, 1, 0, 10, 9]
];

var y_train = [
    25.0, -4.5, 14.5, 19.5, 17.0, 6.5, -11.5, 21.0,
    22.0, 14.5, -1.0, 10.0, 21.0, 36.0, 8.0, -15.0,
    39.0, 8.5, -9.5, 14.5, 11.0, 6.5, 5.5, 23.5,
    29.0, 15.0, 25.0, 23.5, -16.5, -4.0, 26.0, -4.5,
    7.5, 27.0, 8.5, 1.0, -35.5, 30.5, 28.5, 24.0
];

var x_test = [
    [5, -6, -6, 2, 9],
    [2, 0, 5, 8, 5],
    [5, -4, 1, -3, 1],
    [9, 0, 4, 0, 9],
    [-6, 9, 5, -4, -3],
    [6, 0, 9, -1, 7],
    [4, -4, 6, 8, 6],
    [-4, -1, -1, -2, -6],
    [-2, 8, -2, 9, 5],
    [-2, -2, -6, -6, -3],
    [10, -2, 7, 0, 0],
    [-6, 2, 0, 3, 10],
    [1, 4, 2, 7, -2],
    [-5, 5, 8, 10, 7],
    [10, -2, -2, 10, 10],
    [-6, 8, -1, -6, -2],
    [-1, -2, 9, -3, -5],
    [4, 10, 10, 9, -3],
    [-5, 1, 0, 2, -5],
    [-3, 10, 8, -6, -4]
];

var y_test = [
    24.0, 18.5, 26.5, 27.0, -27.5, 21.5, 32.0, 0.5,
    -12.0, -1.0, 44.5, -22.0, 12.0, -11.0, 40.0, -31.5,
    14.5, 16.0, -3.0, -20.0
];

// ---------- Antrenare ----------

var std = standardizeaza(x_train);
var model = regresie_liniara(std[0], y_train, 0.1, 300);

// Revenire la scara originala: w_orig = w / dev, b_orig = b - suma(w * medie / dev)
var w_std = model[0];
var nr_car = lungime(w_std);
var w_orig = [];
var b_orig = model[1];
pentru (var j = 0; j < nr_car; j++) {
    v.adauga(w_orig, w_std[j] / std[2,j]);
    b_orig = b_orig - w_std[j] * std[1,j] / std[2,j];
}

// ---------- Evaluare pe date nevazute ----------

var rezultate = prezice(x_test, w_orig, b_orig);

afiseaza("w apropiat de [3, -2, 0.5, 1, -1]: ", w_orig, "\n");
afiseaza("b apropiat de 7: ", b_orig, "\n");
afiseaza("Eroare MSE: ", eroare_mse(y_test, rezultate), "\n");
afiseaza("Eroare RMSE: ", m.radp(eroare_mse(y_test, rezultate)), "\n");
afiseaza("Eroare MAE: ", eroare_mae(y_test, rezultate), "\n");
afiseaza("R squared: ", eroare_r_squared(y_test, rezultate), "\n");
